# Copie este arquivo para .env antes de executar o Docker Compose.
# Obrigatórias: use valores próprios e fortes. O Compose falhará se estiverem vazias.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
JWT_SECRET=

# Opcionais em desenvolvimento. Sem SendGrid, os links são exibidos apenas no terminal.
SENDGRID_API_KEY=
EMAIL_FROM=
USDA_API_KEY=DEMO_KEY
